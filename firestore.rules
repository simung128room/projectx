rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Primitive Definition
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { 
      // Include User email from runtime as bootstrapped admin
      return (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
             || (isSignedIn() && request.auth.token.email == 'abopboa.b@gmail.com');
    }

    // 1. Users Collection
    function isValidUser(data) {
      return data.keys().hasAll(['email']) &&
             data.email is string && data.email.size() <= 255;
    }
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['email', 'isPremium'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    
    // 2. Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 3. Products Collection
    function isValidProduct(data) {
        return data.keys().hasAll(['name', 'price']) &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
               data.price is number && data.price >= 0;
    }
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(incoming());
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }
    
    // 4. Categories Collection
    function isValidCategory(data) {
        return data.keys().hasAll(['name']) && data.name is string && data.name.size() <= 100;
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidCategory(incoming());
      allow delete: if isAdmin();
    }

    // 5. Purchases Collection
    function isValidPurchase(data) {
        return data.keys().hasAll(['userId', 'productId', 'quantity', 'totalPrice']) &&
               data.userId is string && data.userId.size() <= 128 &&
               data.productId is string && data.productId.size() <= 128 &&
               data.quantity is number && data.quantity > 0 &&
               data.totalPrice is number && data.totalPrice >= 0;
    }
    match /purchases/{purchaseId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Enforce temporal integrity and relational checks
      allow create: if isSignedIn() && isValidPurchase(incoming()) && incoming().userId == request.auth.uid && (
        exists(/databases/$(database)/documents/products/$(incoming().productId))
      );
      allow update: if false; // Purchases are immutable unless admin
      allow delete: if isAdmin();
    }

    // 6. Topups Collection
    function isValidTopup(data) {
        return data.keys().hasAll(['userId', 'amount']) &&
               data.userId is string &&
               data.amount is number && data.amount > 0;
    }
    match /topups/{topupId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidTopup(incoming()) && incoming().userId == request.auth.uid;
      allow update: if false; // Topups are immutable
      allow delete: if isAdmin();
    }

    // 7. Custom Pages
    function isValidCustomPage(data) {
        return data.keys().hasAll(['title', 'content']) &&
               data.title is string && data.title.size() <= 200 &&
               data.content is string;
    }
    match /custom_pages/{pageId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidCustomPage(incoming());
      allow delete: if isAdmin();
    }

    // 8. License Keys
    function isValidLicenseKey(data) {
        return data.keys().hasAll(['product_id', 'key']) &&
               data.product_id is string && data.product_id.size() <= 128 &&
               data.key is string && data.key.size() <= 1000;
    }
    match /license_keys/{keyId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidLicenseKey(incoming());
      allow delete: if isAdmin();
    }

    // 9. Used Keys
    match /used_keys/{keyId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // 10. Blocked IPs
    match /blocked_ips/{ipId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
